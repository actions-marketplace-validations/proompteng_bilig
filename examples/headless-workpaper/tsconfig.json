{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "@bilig/core": ["../../packages/core/src/index.ts"],
      "@bilig/core/headless-runtime": ["../../packages/core/src/headless-runtime.ts"],
      "@bilig/formula": ["../../packages/formula/src/index.ts"],
      "@bilig/formula/external-function-adapter": ["../../packages/formula/src/external-function-adapter.ts"],
      "@bilig/headless": ["../../packages/headless/src/index.ts"],
      "@bilig/headless/mcp": ["../../packages/headless/src/mcp.ts"],
      "@bilig/protocol": ["../../packages/protocol/src/index.ts"],
      "@bilig/workpaper": ["../../packages/workpaper/src/index.ts"],
      "@bilig/workpaper/ai-sdk": ["../../packages/workpaper/src/ai-sdk.ts"],
      "@bilig/workpaper/xlsx": ["../../packages/workpaper/src/xlsx.ts"],
      "bilig-workpaper": ["../../packages/bilig/src/index.ts"],
      "bilig-workpaper/mcp": ["../../packages/bilig/src/mcp.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["*.ts"]
}
